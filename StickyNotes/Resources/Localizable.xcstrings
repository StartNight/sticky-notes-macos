            "value": "继续…"
          }
        }
      }
    },
    "This deletes up to 5 old per-field sign-in entries (access/refresh token, expiry, email, name) left by earlier versions. Your notes and the current session are not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes up to 5 old per-field sign-in entries (access/refresh token, expiry, email, name) left by earlier versions. Your notes and the current session are not touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除早期版本遗留的最多 5 个分字段登录条目（访问/刷新令牌、过期时间、邮箱、名称）。便笺和当前会话不受影响。"
          }
        }
      }
    },
    "Really delete the old entries?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

      }
    },
    "Earlier versions stored sign-in tokens as separate keychain entries. Signing out never deletes them. Remove them here only if you no longer need them; the current sign-in is not affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier versions stored sign-in tokens as separate keychain entries. Signing out never deletes them. Remove them here only if you no longer need them; the current sign-in is not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早期版本把登录令牌分开存成多个钥匙串条目。退出登录不会删除它们。只有在确认不再需要时才在此移除；当前登录不受影响。"
          }
        }
      }
    },
    "Remove old keychain entries…": {
      "localizations": {
        "en": {

      }
    },
    "Explicitly create a new remote copy (duplicate risk)…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitly create a new remote copy (duplicate risk)…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确重新创建远端副本（可能重复）…"
          }
        }
      }
    },
    "Association preserves local snapshots and archives other local representations without deleting cloud objects. Recreate can leave duplicates. Never infer absence from the first page or text similarity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association preserves local snapshots and archives other local representations without deleting cloud objects. Recreate can leave duplicates. Never infer absence from the first page or text similarity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联会保全本地快照，并暂停保留其他本地副本，不会删除云端对象。重建可能产生重复，不能用首屏未找到或文本相似来推断结果。"
          }
        }
      }
    },
    "Link this exact verified object, restore visibility, and resume later updates. Preserve local snapshots and old references. No automatic cloud merge, deletion, or recreate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link this exact verified object, restore visibility, and resume later updates. Preserve local snapshots and old references. No automatic cloud merge, deletion, or recreate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联本次已核验的具体对象，恢复可见并允许后续更新；保全本地快照与旧引用。不自动合并、删除或重建云端对象。"
          }
        }
      }
    },
    "Delete exactly the verified remote object, then retain the source locally with sync paused. Other unknown copies are not automatically found or deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete exactly the verified remote object, then retain the source locally with sync paused. Other unknown copies are not automatically found or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除已核验的这个远端对象；源内容保留在本地并暂停同步。不会自动查找或删除其他未知副本。"
          }
        }
      }
    },
    "Delete only this verified retained old ID. Do not resolve any separate unknown creation by guessing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete only this verified retained old ID. Do not resolve any separate unknown creation by guessing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除已核验的这个旧 ID，不猜测或解除另一项未知创建。"
          }
        }
      }
    },
    "You are authorizing a new POST in the original account. The old POST may already exist: duplicates or orphan objects are possible. Preserve old operation history and do not automatically delete old objects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are authorizing a new POST in the original account. The old POST may already exist: duplicates or orphan objects are possible. Preserve old operation history and do not automatically delete old objects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将明确授权在原账号重新 POST。旧请求可能已落地，可能产生重复或孤立对象。保留旧操作历史，不自动删除旧对象。"
          }
        }
      }
    },
    "Restore local visibility with sync paused. Keep unknown creation markers and all audit records; do not write to Microsoft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore local visibility with sync paused. Keep unknown creation markers and all audit records; do not write to Microsoft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复本地可见并暂停同步，保留未知创建标记与全部审计记录，不向微软写入。"
          }
        }
      }
    },
    "Action recorded. Review retained references and sync status; this is not proof that all cloud copies are gone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action recorded. Review retained references and sync status; this is not proof that all cloud copies are gone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已记录。请继续核对旧引用与同步状态；这不证明所有云端副本均已消失。"
          }
        }
      }
    },
    "Recovery paused — local content only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery paused — local content only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复已暂停：仅保留本地内容"
          }
        }
      }
    },
    "Local Data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据"
          }
        }
      }
    },
    "Notes from other accounts, no-account notes and legacy unowned notes are hidden here and never uploaded to this account. Manage them under Local Data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes from other accounts, no-account notes and legacy unowned notes are hidden here and never uploaded to this account. Manage them under Local Data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他账号的便笺、无账号便笺和旧版本归属不明的便笺在此处不显示，也不会上传到当前账号。请到「本地数据」管理。"
          }
        }
      }
    },
    "Allow replacement sync for this note (local setting)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow replacement sync for this note (local setting)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此便笺使用替换式同步（仅本地设置）"
          }
        }
      }
    },
    "If updates to the linked object keep failing (for example without ShortNotes permission), this lets the normal create-then-delete replacement run for this note. No Microsoft write happens now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If updates to the linked object keep failing (for example without ShortNotes permission), this lets the normal create-then-delete replacement run for this note. No Microsoft write happens now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若对已关联对象的更新持续失败（例如缺少 ShortNotes 权限），此项允许此便笺走常规的「先新建再删除」替换流程。此刻不会向微软写入任何内容。"
          }
        }
      }
    },
    "Current data scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current data scope"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据范围"
          }
        }
      }
    },
